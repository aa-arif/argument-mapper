# Anthropic API key. Must be a WORKSPACE-scoped key, not an Admin key
# (an sk-ant-admin key returns 400 "not scoped to a workspace" on /v1/messages).
ANTHROPIC_API_KEY=sk-ant-...

# Comma-separated origins allowed by the serving layer.
CORS_ORIGINS=http://localhost:5173

# Hard ceiling on cumulative Anthropic spend, in USD. The cost ledger raises
# before a request would exceed this.
ARGMAP_SPEND_CAP_USD=20.0

# Base URL of the local vLLM server used by the `local` and `cascade` routes.
ARGMAP_VLLM_URL=http://localhost:8001
